# ============================================
# Environment Configuration
# ============================================

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Sentinel Hub
SH_CLIENT_ID=your_sentinel_hub_client_id_here
SH_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# Copernicus (Optional - for direct Copernicus API access)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# MapTiler (Optional)
MAPTILER_API_KEY=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=6
DEFAULT_SEARCH_BOUNDS=POLYGON((12 48, 16 48, 16 52, 12 52, 12 48))
DEFAULT_CLOUD_MAX=30.0
PROCESS_HISTORICAL_DATA=false

# Cache
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE=104857600
